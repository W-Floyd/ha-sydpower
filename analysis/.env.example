# Credentials for the catalog extractor's authenticated endpoints.
# Copy to .env — which is gitignored — and fill in. No `export` needed: the
# script reads this file directly, so sourcing it is unnecessary.
BRIGHTEMS_USER=your-account-username-email-or-mobile
BRIGHTEMS_PASSWORD=your-password
# Optional: skip the interactive prompt for the emailed verification code.
# BRIGHTEMS_CODE=123456
